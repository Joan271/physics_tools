\ProvidesPackage{packages/mycommands}[2024/06/01 Custom commands for physics and math]
% Diferential operators written in bold words
\renewcommand{\grad}{\textrm{\mathbf{grad}}} 
\DeclareMathOperator{\rot}{\textrm{\mathbf{rot}}}
\DeclareMathOperator{\diver}{\textrm{\mathbf{div}}}

% Common transforms
\newcommand{\FT}[1]{\mathcal{F}\qty{#1}}
\newcommand{\LT}[1]{\mathcal{L}\qty{#1}}

% Common matrix operations
\renewcommand{\Tr}[1]{\mathrm{Tr}\qty(#1)}
\newcommand{\diag}[1]{\mathrm{diag}\qty(#1)}

% Common logical commands 
\newcommand{\tf}{\;\therefore\;}
\newcommand{\bc}{\;\because\;}
\newcommand{\eqdef}{\overset{\text{def}}{=}}
\newcommand{\qeq}{\overset{\text{?}}{=}}

% Other common symbols in calculus 
\DeclareMathOperator{\sign}{\mathrm{sign}}
\newcommand{\mean}[1]{\langle #1 \rangle}
\providecommand{\ct}{\mathrm{const} } 
\DeclareMathOperator{\floor}{\mathrm{floor}}
\DeclareMathOperator{\ceil}{\mathrm{ceil}}
%Spanish
\addto\captionsspanish{\def\ct{\mathrm{cte}}}
%English
\addto\captionsenglish{\def\ct{\mathrm{const}}}

% Common symbols in quantum mechanics (although it can be used in other contexts, e.g. relations between variables) 
\newcommand{\up}{\uparrow}
\newcommand{\down}{\downarrow}

