%Helper functions
\makeatletter
\newcommand{\renderifnotempty}[2]{%
  \edef\@temp{#1}%
  \if\relax\detokenize\expandafter{\@temp}\relax
  \else
    #2%
  \fi
}
%\newcommand{\renderifnotempty}[2]{
% \ifx#1\@empty 
% \else 
%   #2 
% \fi
%} 
\newcommand{\renderpair}[3]{%
    \edef\@a{#1}%
    \edef\@b{#2}%

    \if\relax\detokenize\expandafter{\@a}\relax
        \if\relax\detokenize\expandafter{\@b}\relax
        \else
            \@b
        \fi
    \else
        \@a
        \if\relax\detokenize\expandafter{\@b}\relax
        \else
           \;#3\;\@b
        \fi
    \fi
}
