\renewcommand*{\proofname}{\normalfont\bfseries \prooffname}
%% define environments
\declaretheorem[style=definition, name=\protect\theoremname, numbered=yes, numberwithin=section]{theorem}
\declaretheorem[style=definition, name=\protect\theoremname, numbered=no]{theorem*}

\declaretheorem[style=plain, name=\protect\propositionname, numbered=yes, sibling=theorem]{proposition}
\declaretheorem[style=plain, name=\protect\propositionname, numbered=no]{proposition*}

\declaretheorem[style=definition, name=\protect\corollaryname, numbered=yes, sibling=theorem]{corollary}
\declaretheorem[style=definition, name=\protect\corollaryname, numbered=no]{corollary*}

\declaretheorem[style=definition, name=\protect\lemmaname, numbered=yes, sibling=theorem]{lemma}
\declaretheorem[style=plain, name=\protect\lemmaname, numbered=no]{lemma*}

\declaretheorem[style=definition, name=\protect\claimname, numbered=yes, sibling=theorem]{claim}
\declaretheorem[style=plain, name=\protect\claimname, numbered=no]{claim*}

\declaretheorem[style=definition, name=\protect\definitionname, numbered=yes, numberwithin=section]{definition}
\declaretheorem[style=definition, name=\protect\definitionname, numbered=no]{definition*}

\declaretheorem[style=definition, name=\protect\examplename, numbered=yes, numberwithin=section]{example}
\declaretheorem[style=definition, name=\protect\examplename, numbered=no]{example*}


\declaretheoremstyle[headfont=\itshape, bodyfont=\normalfont, spaceabove=1pt, spacebelow=3pt]{remarkstyle} 

\declaretheorem[style=remarkstyle, name=Remark, numbered=yes, numberwithin=section]{remark}
\declaretheorem[style=remarkstyle, name=Remark, numbered=no]{remark*}

\declaretheoremstyle[headfont=\color{blue!80}\bfseries, bodyfont=\normalfont, spaceabove=3pt, spacebelow=3pt]{notestyle}

\declaretheorem[style=notestyle, name=Note, numbered=yes, numberwithin=section]{note}
\declaretheorem[style=notestyle, name=Note, numbered=no]{note*}

\declaretheoremstyle[headfont=\bfseries, bodyfont=\normalfont, spaceabove=3pt, spacebelow=3pt, qed=\ensuremath{\square}]{solutionstyle}

\declaretheoremstyle[
 headfont=\normalfont\bfseries, 
 bodyfont=\normalfont, 
 notefont=\normalfont\bfseries, 
 notebraces={}{}, 
 headpunct ={}, 
 postheadspace = \newline, 
 spaceabove=3pt, 
 spacebelow=3pt]{problemstyle} 


\declaretheorem[style=problemstyle, name=\protect\problemname, numbered=yes, numberwithin=section]{problem}
\declaretheorem[style=problemstyle, name=\protect\problemname, numbered=no]{problem*}

\declaretheorem[style=solutionstyle, name=Solution, numbered=yes, numberwithin=section]{solution}
\declaretheorem[style=solutionstyle, name=Solution, numbered=no]{solution*}

\declaretheorem[style=problemstyle, name=, numbered=no]{raw}

 


\usepackage[most]{tcolorbox}

\newcommand{\newtcbenvironment}[2]{
    \tcolorboxenvironment{#1}{#2, enhanced, breakable, sharp corners,leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt}
    \tcolorboxenvironment{#1*}{#2, enhanced, breakable, rounded corners,leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt}
}

%% define styles

\newtcbenvironment{theorem}{colframe=RoyalPurple, colback=RoyalPurple!8}
\newtcbenvironment{proposition}{colframe=RoyalPurple, colback=RoyalPurple!8}
\newtcbenvironment{corollary}{colframe=NavyBlue, colback=SkyBlue!8}
\newtcbenvironment{lemma}{colframe=NavyBlue, colback=SkyBlue!8}
\newtcbenvironment{claim}{colframe=NavyBlue, colback=SkyBlue!8}
\newtcbenvironment{remark}{colframe=Grey, colback=SkyBlue!8} 
\newtcbenvironment{definition}{colframe=ForestGreen, colback=ForestGreen!5}
\newtcbenvironment{raw}{colframe=NavyBlue, colback=SkyBlue!8}
\newtcbenvironment{example}{colframe=RawSienna, colback=RawSienna!5}
\newtcbenvironment{problem}{colframe=WildStrawberry!30, colback=ForestGreen!2}

%% cbox
\newtcolorbox{cbox}[1][]{%
    enhanced,
    breakable,
    sharp corners,
    leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt,
    colframe=SkyBlue,
    colback=SkyBlue!8,
    #1
}

%% ===========================
%% RESOLUTION COMMAND
%% ===========================
\newcommand{\Solution}{
    \vspace*{1em}
    \hrule
    \vspace*{1em}
    {\color{blue} \protect\solutionname:}\\
}
